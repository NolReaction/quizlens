{
  "manifest_version": 3,
  "name": "QuizLens · чтение вкладки",
  "version": "1.8.0",
  "minimum_chrome_version": "106",
  "description": "Передаёт видимый текст вопроса и вариантов в выбранное локальное окно QuizLens.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {"default_title": "QuizLens · чтение вкладки", "default_popup": "popup.html"},
  "background": {"service_worker": "background.js"}
}
